@startuml class_diagram
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

' --- Color scheme ---
' UML 2.5.1 core stereotypes: <<interface>>, <<component>>, <<dataType>>, <<enumeration>>
' Non-stereotyped classes use internal tags for coloring only

skinparam class {
    BackgroundColor<<interface>> #D6EAF8
    BorderColor<<interface>> #2980B9
    BackgroundColor<<component>> #D5F5E3
    BorderColor<<component>> #27AE60
    BackgroundColor<<pipeline>> #FDEBD0
    BorderColor<<pipeline>> #E67E22
    BackgroundColor<<dataType>> #E8DAEF
    BorderColor<<dataType>> #8E44AD
    BackgroundColor<<session>> #D1F2EB
    BorderColor<<session>> #1ABC9C
    BackgroundColor<<ui>> #FADBD8
    BorderColor<<ui>> #E74C3C
    BackgroundColor<<enumeration>> #F2F3F4
    BorderColor<<enumeration>> #95A5A6
    BackgroundColor<<r>> #E5E7E9
    BorderColor<<r>> #707B7C
}

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #CCCCCC
}

title Chip Identifier Recognition System — Class Diagram (UML 2.5.1)

' ============================================================
' Operation Interfaces
' ============================================================
package "Operations" {

    abstract class Operation <<interface>> {
        + {abstract} __call__(...) : result
        + {static} get_default_parameters() : dict
    }

    abstract class ChipRegionDetection <<interface>> {
        + {abstract} __call__(image: ndarray, params: dict)\n    : BoundingBox | Contour
    }

    abstract class ContourBasedDetection <<interface>> {
        + {abstract} __call__(image: ndarray, params: dict)\n    : RotatedRect, Contour
    }

    abstract class FeatureBasedAlignment <<interface>> {
        + {abstract} __call__(image: ndarray,\n    template: ndarray,\n    keypoints: list, params: dict)\n    : HomographyMatrix, ndarray
    }

    abstract class ContourBasedAlignment <<interface>> {
        + {abstract} __call__(image: ndarray,\n    rotated_rect: RotatedRect, params: dict)\n    : ndarray
    }

    abstract class TextRegionDetection <<interface>> {
        + {abstract} __call__(image: ndarray, params: dict)\n    : list[BoundingBox]
    }

    abstract class CropPreprocessing <<interface>> {
        + {abstract} __call__(image: ndarray, params: dict)\n    : ndarray
    }

    abstract class TextRecognition <<interface>> {
        + {abstract} __call__(image: ndarray, params: dict,\n    charset_hint: set | None)\n    : str, float
    }

    Operation <|-- ChipRegionDetection
    Operation <|-- ContourBasedDetection
    Operation <|-- FeatureBasedAlignment
    Operation <|-- ContourBasedAlignment
    Operation <|-- TextRegionDetection
    Operation <|-- CropPreprocessing
    Operation <|-- TextRecognition
}

' ============================================================
' Operators (Framework Wrappers)
' ============================================================
package "Operators" {

    class OpenCVOperator <<component>> {
        - _feature_detector : object {lazy}
        - _contour_detector : object {lazy}
        - _preprocessor : object {lazy}
        + __call__(...) : result
    }

    class PaddleOCROperator <<component>> {
        - _detection_model : object {lazy}
        - _recognition_model : object {lazy}
        + __call__(...) : result
    }

    class EasyOCROperator <<component>> {
        - _reader : object {lazy}
        + __call__(...) : result
    }

    class TesseractOperator <<component>> {
        + __call__(...) : result
    }
}

' --- Operator-Operation implementation relationships ---
OpenCVOperator ..|> ChipRegionDetection
OpenCVOperator ..|> ContourBasedDetection
OpenCVOperator ..|> FeatureBasedAlignment
OpenCVOperator ..|> ContourBasedAlignment
OpenCVOperator ..|> CropPreprocessing

PaddleOCROperator ..|> TextRegionDetection
PaddleOCROperator ..|> TextRecognition

EasyOCROperator ..|> TextRegionDetection
EasyOCROperator ..|> TextRecognition

TesseractOperator ..|> TextRecognition

' ============================================================
' Pipeline Infrastructure
' ============================================================
class OperatorRegistry <<pipeline>> {
    - _instance : OperatorRegistry {singleton}
    - _registry : dict[type[Operation], list[type]]
    + register(operator_class, operations: list) : void
    + get_operators_for(operation: type[Operation]) : list[type]
    + validate_assignment(pipeline: Pipeline) : bool
}

class OperatorPool <<pipeline>> {
    - _instances : dict[type, object]
    - _pipeline : Pipeline
    + get_operator(operator_class: type) : object
    + release_unused() : void
}

class Stage <<pipeline>> {
    - name : str
    - required_operation : type[Operation]
    - assigned_operator_class : type
    - parameters : dict
    + run_calibration(image: ndarray,\n    session: CalibrationSession) : StageResult
    + run_batch(image: ndarray,\n    session: CalibrationSession) : StageResult
}

abstract class Pipeline <<pipeline>> {
    - _stages : list[Stage]
    - _pool : OperatorPool
    - _pipeline_options : PipelineOptions
    + {abstract} get_stages() : list[Stage]
    + {abstract} create_calibration_controller()\n    : CalibrationController
    + run_calibration(image: ndarray,\n    session: CalibrationSession) : void
    + run_batch(images: list[Path],\n    session: CalibrationSession) : list[BatchResult]
    --signals--
    + progress_updated(current: int, total: int)
    + image_completed(filename: str, result: BatchResult)
    + batch_completed(results: list[BatchResult])
}

class FeatureBasedAlignmentPipeline <<pipeline>> {
    + get_stages() : list[Stage]
    + create_calibration_controller()\n    : FeatureAlignmentController
}

class ContourBasedAlignmentPipeline <<pipeline>> {
    + get_stages() : list[Stage]
    + create_calibration_controller()\n    : ContourAlignmentController
}

class DirectROIPipeline <<pipeline>> {
    + get_stages() : list[Stage]
    + create_calibration_controller()\n    : DirectROIController
}

Pipeline <|-- FeatureBasedAlignmentPipeline
Pipeline <|-- ContourBasedAlignmentPipeline
Pipeline <|-- DirectROIPipeline

' ============================================================
' Configuration
' ============================================================
class SessionConfig <<dataType>> {
    + last_folder : Path | None
    + last_pipeline_config_name : str | None
}

class Configuration <<pipeline>> {
    + pipeline : str
    + pipeline_options : PipelineOptions
    + stages : dict[str, StageConfig]
    + save(path: Path) : void
    + {static} load(path: Path) : Configuration
}

class PipelineOptions <<dataType>> {
    + identifier_pattern_preset : str = "Default (accept any)"
    + rough_rotation_degrees : float = 0.0
    + invert_colors : bool = false
    + manual_confirmation_required : bool = true
    + confidence_threshold_percent : float = 85.0
    + debug_export_mode : DebugExportMode = DISABLED
}

class StageConfig <<dataType>> {
    + operator : str
    + parameters : dict
}

Configuration *-- PipelineOptions
Configuration *-- "1..*" StageConfig

' ============================================================
' IdentifierPatternPreset
' ============================================================
class IdentifierPatternPreset <<dataType>> {
    + name : str
    + regex : str
    + description : str
}

class IdentifierPatternPresetRegistry <<pipeline>> {
    - _presets : dict[str, IdentifierPatternPreset]
    - {static} _DEFAULT_PRESET : IdentifierPatternPreset
    + {static} load(path: Path) : IdentifierPatternPresetRegistry
    + get_preset_names() : list[str]
    + get_preset(name: str) : IdentifierPatternPreset
}

IdentifierPatternPresetRegistry *-- "1..*" IdentifierPatternPreset

' ============================================================
' CalibrationSession hierarchy
' ============================================================
abstract class CalibrationSession <<session>> {
    + example_image : ndarray
    + rough_rotation_degrees : float
    + invert_colors : bool
}

class FeatureAlignmentCalibrationSession <<session>> {
    + template_image : ndarray
    + template_keypoints : list
    + template_descriptors : ndarray
    + chip_region : BoundingBox | Contour
    + identifier_roi : BoundingBox
}

class ContourAlignmentCalibrationSession <<session>> {
    + template_image : ndarray
    + chip_region_contour : Contour
    + chip_region_rotated_rect : RotatedRect
    + identifier_roi : BoundingBox
}

class DirectROICalibrationSession <<session>> {
    + identifier_roi : BoundingBox
    + roi_tolerance_margin : int
}

CalibrationSession <|-- FeatureAlignmentCalibrationSession
CalibrationSession <|-- ContourAlignmentCalibrationSession
CalibrationSession <|-- DirectROICalibrationSession

' ============================================================
' Processing Outcome, Review State & Debug Export Mode
' ============================================================
enum DebugExportMode <<enumeration>> {
    DISABLED
    CALIBRATION
    ALL
}

enum ProcessingOutcome <<enumeration>> {
    PASSED
    LOW_CONFIDENCE
    VALIDATION_FAILED
    FAILED
    PROCESSING_ERROR
}

enum ReviewState <<enumeration>> {
    AUTO_ACCEPTED
    PENDING_REVIEW
    NEEDS_ATTENTION
    CRITICAL
    MANUALLY_CONFIRMED
    --
    + color : QColor
}

class ReviewStateMapping <<r>> {
    + {static} AUTO_MODE : dict[ProcessingOutcome, ReviewState]
    + {static} MANUAL_MODE : dict[ProcessingOutcome, ReviewState]
}

ReviewStateMapping ..> ProcessingOutcome : maps from
ReviewStateMapping ..> ReviewState : maps to

' ============================================================
' Batch result
' ============================================================
class BatchResult <<r>> {
    + filename : str
    + identifier_text : str
    + confidence : float
    + outcome : ProcessingOutcome
    + error_detail : str | None
}

BatchResult *-- ProcessingOutcome

' ============================================================
' UI Architecture (Passive View pattern)
' ============================================================
class SciBitTool <<ui>> {
    - _current_pipeline : Pipeline
    - _calib_session : CalibrationSession
    - _configuration : Configuration
    + open_from_path(path: Path) : void
    - _start() : void
    - _stop() : void
    - _show_calibration_widget() : void
    - _show_results_widget() : void
}

class CalibrationWidget <<ui>> {
    + load_image(path: Path) : void
    + set_step(current: int, total: int, description: str) : void
    + set_buttons(specs: list[tuple]) : void
    + button(name: str) : QPushButton | None
    + start_roi_selection(mode: str) : void
    + stop_roi_selection() : void
    + show_rect_overlay(rect, color, width) : void
    + clear_overlays() : void
    + show_ocr_panel(text: str) : void
    + hide_ocr_panel() : void
    + show_error(message: str) : void
    --signals--
    + roi_drawn(mode: str, rect: QRectF)
    + ocr_confirmed(text: str)
    + calibration_complete(CalibrationSession)
    + calibration_cancelled()
}

abstract class CalibrationController <<ui>> {
    + {abstract} start(widget: CalibrationWidget,\n    image_paths: list[Path]) : void
    --signals--
    + calibration_complete(CalibrationSession)
    + calibration_cancelled()
}

class FeatureAlignmentController <<ui>> {
    + start(widget: CalibrationWidget,\n    image_paths: list[Path]) : void
}

class ContourAlignmentController <<ui>> {
    + start(widget: CalibrationWidget,\n    image_paths: list[Path]) : void
}

class DirectROIController <<ui>> {
    + start(widget: CalibrationWidget,\n    image_paths: list[Path]) : void
}

CalibrationController <|-- FeatureAlignmentController
CalibrationController <|-- ContourAlignmentController
CalibrationController <|-- DirectROIController

class ResultsWidget <<ui>> {
    - _result_map : dict[str, tuple[BatchResult, QListWidgetItem]]
    - _review_queue : list[str]
    - _review_index : int
    + has_unconfirmed : bool
    --signals--
    + batch_complete()
}

class ReviewPanel <<ui>> {
    - _identifier_edit : QLineEdit
    + load_result(result: BatchResult) : void
    + set_navigation_state(has_prev: bool, has_next: bool) : void
    --signals--
    + rename_applied(original_path: Path, new_name: str)
    + skipped(original_path: Path)
    + navigate(delta: int)
}

ResultsWidget *-- ReviewPanel

' ============================================================
' Relationships
' ============================================================

' --- SciBitTool orchestration ---
SciBitTool *-- "0..1" Pipeline : owns
SciBitTool *-- "0..1" CalibrationWidget : shows during calibration
SciBitTool *-- "0..1" ResultsWidget : shows during review
SciBitTool --> Configuration : loads
SciBitTool --> SessionConfig : persists UI state

' --- CalibrationWidget / Controller ---
CalibrationWidget o-- CalibrationController : driven by
Pipeline ..> CalibrationController : creates via\ncreate_calibration_controller()

' --- Concrete pipeline → concrete controller ---
FeatureBasedAlignmentPipeline ..> FeatureAlignmentController : creates
ContourBasedAlignmentPipeline ..> ContourAlignmentController : creates
DirectROIPipeline ..> DirectROIController : creates

' --- Concrete pipeline → concrete session ---
FeatureBasedAlignmentPipeline ..> FeatureAlignmentCalibrationSession : creates
ContourBasedAlignmentPipeline ..> ContourAlignmentCalibrationSession : creates
DirectROIPipeline ..> DirectROICalibrationSession : creates

' --- Pipeline internals ---
Pipeline *-- "1..*" Stage : ordered sequence
Pipeline *-- "1" OperatorPool : owns
Pipeline o-- "1" CalibrationSession : uses per session
Pipeline o-- "1" Configuration : constructed from

Stage --> OperatorPool : get_operator()
Stage ..> Operation : requires

OperatorPool --> OperatorRegistry : resolves classes

' --- Operator registration ---
OperatorRegistry <.. OpenCVOperator : registers
OperatorRegistry <.. PaddleOCROperator : registers
OperatorRegistry <.. EasyOCROperator : registers
OperatorRegistry <.. TesseractOperator : registers

' --- Results ---
Pipeline ..> BatchResult : produces
ResultsWidget --> ReviewStateMapping : maps outcome\nto review state
ResultsWidget --> BatchResult : displays

' --- Configuration ---
PipelineOptions ..> IdentifierPatternPresetRegistry : resolves preset by name
PipelineOptions *-- DebugExportMode

' ============================================================
' Legend
' ============================================================
legend right
  |= Color |= UML 2.5.1 Stereotype |= Meaning |
  | <#D6EAF8> | <<interface>> | Abstract operation interfaces |
  | <#D5F5E3> | <<component>> | Concrete operator implementations |
  | <#FDEBD0> | — | Pipeline orchestration infrastructure |
  | <#E8DAEF> | <<dataType>> | Pure value data structures |
  | <#D1F2EB> | — | Calibration session data |
  | <#FADBD8> | — | UI classes |
  | <#F2F3F4> | <<enumeration>> | Enumerated types |
  | <#E5E7E9> | — | Result & mapping classes |
endlegend

@enduml
