@startuml batch_processing_sequence
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceArrowThickness 1.5
skinparam sequenceLifeLineBorderColor #555555
skinparam sequenceParticipantBackgroundColor #FAFAFA
skinparam sequenceParticipantBorderColor #999999
skinparam sequenceGroupBackgroundColor #F5F5F5

title Batch Processing Flow (UML 2.5.1)

participant "SciBitTool" as Tool
participant "ResultsWidget" as RW
participant "ReviewPanel" as RP
participant "Pipeline" as P
participant "Stage" as S
participant "OperatorPool" as Pool
participant "Operator" as Op
participant "CalibrationSession" as CS
participant "IdentifierPattern\nPresetRegistry" as Reg
participant "ReviewStateMapping" as RSM
actor User

== Batch Start ==

Tool -> RW : create ResultsWidget(pipeline, config)
activate RW
RW -> P : connect signals\n(image_completed, progress_updated, batch_completed)
RW -> RSM : select mapping based on\nmanual_confirmation_required
activate RSM
RSM --> RW : active mapping dict
deactivate RSM
Tool -> P : start_batch(images, session, config)
activate P
Tool -> Tool : record batch start time

== Per-Image Processing (sequential loop) ==

loop for each image in batch

    P -> P : apply rough_rotation(image,\nsession.rough_rotation_degrees)
    P -> P : apply invert_colors(image)\nif session.invert_colors

    loop for each stage in pipeline

        P -> S : run_batch(preprocessed_image, session)
        activate S
        S -> Pool : get_operator(assigned_operator_class)
        activate Pool
        Pool --> S : operator instance (cached)
        deactivate Pool

        S -> CS : read calibration data\n(template / ROI / etc.)
        activate CS
        CS --> S
        deactivate CS

        S -> Op : __call__(image, params)
        activate Op
        Op --> S : stage result
        deactivate Op

        opt debug_export_mode == ALL
            S -> S : save interim images to\n_debug_<timestamp>/<image_name>/\n<stage_name>_<step>.png
        end

        S --> P : StageResult
        deactivate S

    end

    == Result Classification (Pipeline layer) ==

    P -> P : extract recognized_text\nand confidence from\nfinal StageResult

    P -> Reg : get_preset(preset_name)
    activate Reg
    Reg --> P : IdentifierPatternPreset (regex)
    deactivate Reg

    P -> P : match text against regex
    P -> P : compare confidence vs. threshold

    alt confidence >= threshold AND regex matches
        P -> P : outcome = PASSED
    else confidence < threshold AND regex matches
        P -> P : outcome = LOW_CONFIDENCE
    else confidence >= threshold AND regex fails
        P -> P : outcome = VALIDATION_FAILED
    else confidence < threshold AND regex fails
        P -> P : outcome = FAILED
    end

    P -> P : create BatchResult(\nfilename, text, confidence, outcome)

    note over P
        Pipeline emits BatchResult
        with ProcessingOutcome only.
        No ReviewState, no colors,
        no file operations.
    end note

    == Signal Emission ==

    P ->> RW : <<signal>> image_completed(BatchResult)
    P ->> RW : <<signal>> progress_updated(current, total)

    == UI-Layer Processing (ResultsWidget) ==

    RW -> RSM : map(outcome) using active mapping
    activate RSM
    RSM --> RW : ReviewState + color
    deactivate RSM

    RW -> RW : add item to results list\n(filename + OCR text + confidence,\ncolor-coded by ReviewState)

    opt ReviewState == AUTO_ACCEPTED
        RW -> RW : copy file as\n{identifier}_{stem}.ext
        note right
            JPEG originals: copy as JPEG
            (no re-encoding)
            Other formats: save as JPEG
            quality 90
        end note
    end

    RW -> RW : update progress bar
    RW -> RW : update summary label\n"Total: X | Accepted: Y | ..."

end

== Batch Complete ==

P ->> RW : <<signal>> batch_completed()
deactivate P

RW -> RW : hide progress bar
RW -> RW : update final summary

RW ->> Tool : <<signal>> batch_complete()
Tool -> Tool : record batch end time
Tool -> Tool : log timing summary\n(calibration, batch, avg per image)
Tool -> Tool : re-enable control bar

== Manual Review Phase ==

opt results needing review exist

    User -> RW : double-clicks reviewable item\nin results list
    RW -> RP : show ReviewPanel
    activate RP
    RW -> RP : load_result(BatchResult)
    RP -> RP : display image preview
    RP -> RP : show info (filename, OCR text, confidence)
    RP -> RP : set identifier_edit text\n(auto-focused, text selected)
    RP -> RP : set_navigation_state(has_prev, has_next)
    RP --> User : review panel visible

    loop review queue

        alt User confirms (Enter key or Rename button)
            User -> RP : presses Enter / clicks Rename
            RP ->> RW : <<signal>> rename_applied(path, new_name)
            RW -> RW : copy file as\n{new_name}_{stem}.ext
            RW -> RW : update item text:\n"filename → new_filename | Manual | ✓"
            RW -> RW : update item color to\nMANUALLY_CONFIRMED (blue)
            RW -> RW : remove from review queue
            RW -> RW : update summary label

            alt review queue not empty
                RW -> RP : load_result(next BatchResult)
                RP -> RP : auto-focus identifier_edit
                RP --> User : show next review item
            else review queue empty
                RW -> RP : hide ReviewPanel
                deactivate RP
            end

        else User navigates (arrow keys or buttons)
            User -> RP : presses Left/Right or\nclicks Prev/Next
            RP ->> RW : <<signal>> navigate(delta)
            RW -> RW : update review_index
            RW -> RP : load_result(BatchResult at new index)
            RP -> RP : update navigation button state
            RP --> User : show prev/next review item

        else User skips
            User -> RP : clicks Skip
            RP ->> RW : <<signal>> skipped(path)
            RW -> RW : advance review_index
            RW -> RP : load_result(next BatchResult)
            RP --> User : show next review item
        end

    end

end

== Unconfirmed Work Protection ==

note over User, Tool
    If User attempts to open a new folder,
    stop the batch, or start a new run while
    ResultsWidget.has_unconfirmed == true,
    SciBitTool shows a confirmation dialog
    before proceeding.
end note

@enduml
