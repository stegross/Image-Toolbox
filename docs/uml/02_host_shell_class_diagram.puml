@startuml host_shell_class_diagram
!theme plain
title Host Shell – Class Diagram (Tool Interface & Core)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

' ============================================================================
' Tool Interface
' ============================================================================
package "plugin" {

    abstract class IToolPlugin <<abstract>> {
        + {abstract} name : str
        + {abstract} category : str
        + {abstract} description : str
        + {abstract} icon_path : str
        + {abstract} version : str
        --
        + {abstract} create_widget(parent: QWidget) : QWidget
        + on_activate() : None
        + on_deactivate() : None
        + on_close() : None
        + get_metadata() : dict
    }

    abstract class IBaseToolPlugin <<abstract>> {
        + allow_multiple_instances : bool = True
        + auto_open_on_startup : bool = True
        + closable : bool = False
        + category : str = "Base"
    }

    IBaseToolPlugin -up-|> IToolPlugin

    class ToolRegistry {
        - _registered_tools : dict[str, type[IToolPlugin]]
        - _instances : dict[str, QWidget]
        --
        + {static} register(plugin_cls: type[IToolPlugin]) : None
        + get_tool(name: str) : type[IToolPlugin]
        + get_tools_by_category(category: str) : list[type[IToolPlugin]]
        + get_all_categories() : list[str]
        + get_base_tools() : list[type[IBaseToolPlugin]]
        + is_instantiated(name: str) : bool
        + set_instance(name: str, widget: QWidget) : None
        + remove_instance(name: str) : None
    }

    ToolRegistry o-right- IToolPlugin : holds\nregistered\ntool classes
}

' ============================================================================
' Shell / UI
' ============================================================================
package "shell" {

    class MainWindow {
        - _docking_manager : DockingManager
        - _nav_bar : NavigationBar
        - _tool_registry : ToolRegistry
        --
        + initialize() : None
        + open_tool(name: str) : None
        + close_tool(name: str) : None
        + save_layout() : None
        + restore_layout() : None
        - _open_base_tools() : None
        # closeEvent(event: QCloseEvent) : None
    }

    class DockingManager {
        - _dock_manager : CDockManager
        - _dock_widgets : dict[str, CDockWidget]
        --
        + add_tool_widget(name: str, widget: QWidget,\n\tclosable: bool) : CDockWidget
        + remove_tool_widget(name: str) : None
        + focus_widget(name: str) : None
        + save_state() : QByteArray
        + restore_state(state: QByteArray) : bool
    }

    class NavigationBar {
        - _tool_registry : ToolRegistry
        - _category_tabs : dict[str, QWidget]
        --
        + build_navigation() : None
        + on_tool_selected(name: str) : None
        - _create_category_tab(category: str) : QWidget
    }

    class LayoutPersistence {
        - _state_file : Path
        --
        + save(state: QByteArray) : None
        + load() : QByteArray | None
        + exists() : bool
        + reset() : None
    }

    MainWindow *-- DockingManager
    MainWindow *-- NavigationBar
    MainWindow ..> LayoutPersistence : uses
    NavigationBar ..> ToolRegistry : reads
    MainWindow ..> ToolRegistry : opens tools from
}

' ============================================================================
' Application Core
' ============================================================================
package "core" {

    class Application {
        - _main_window : MainWindow
        - _tool_registry : ToolRegistry
        - _role_manager : RoleManager
        - _config_manager : ConfigManager
        - _logger : Logger
        --
        + run() : int
        - _initialize_logging() : None
        - _check_roles() : None
        - _create_main_window() : None
    }

    class RoleManager {
        - _current_user : str
        - _user_role : Role
        --
        + get_current_user() : str
        + get_role() : Role
        + has_permission(permission: str) : bool
        - _query_windows_account() : str
    }

    class ConfigManager {
        - _config_directory : Path
        - _tool_configs : dict[str, dict]
        --
        + get_tool_config(tool_name: str) : dict
        + set_tool_config(tool_name: str, config: dict) : None
        + save(tool_name: str) : None
        + load(tool_name: str) : dict
    }

    enum Role {
        OPERATOR
        ENGINEER
        ADMIN
    }

    Application *-- ToolRegistry
    Application *-- RoleManager
    Application *-- ConfigManager
    Application *-- MainWindow
    RoleManager ..> Role : uses
}

' ============================================================================
' Base Tools
' ============================================================================
package "tools.base" {

    class ImageViewer {
        + name = "Image Viewer"
        + description = "View inspection images"
        --
        + create_widget(parent) : QWidget
    }

    class FileExplorer {
        + name = "File Explorer"
        + description = "Browse working directories"
        --
        + create_widget(parent) : QWidget
    }

    class LogViewer {
        + name = "Log Viewer"
        + description = "View application log"
        --
        + create_widget(parent) : QWidget
    }

    ImageViewer --|> IBaseToolPlugin
    FileExplorer --|> IBaseToolPlugin
    LogViewer --|> IBaseToolPlugin
}

' ============================================================================
' Extension Tools
' ============================================================================
package "tools.extensions" {

    class IdentificationTool {
        + name = "Identification Tool"
        + category = "Inspection"
        + allow_multiple_instances = False
        --
        + create_widget(parent) : QWidget
    }

    IdentificationTool --|> IToolPlugin
}

' ============================================================================
' Static registration note
' ============================================================================
note bottom of ToolRegistry
  Tools are statically imported and registered
  at build time in a central registry module:

  ToolRegistry.register(ImageViewer)
  ToolRegistry.register(FileExplorer)
  ToolRegistry.register(LogViewer)
  ToolRegistry.register(IdentificationTool)

  No runtime plugin discovery.
  Enforces implementation rules at compile/build time.
end note

@enduml
