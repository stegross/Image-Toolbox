@startuml host_shell_component_diagram
!theme plain
title Host Shell – Component Diagram

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

' ============================================================================
' LAYER 1 – Tools (top)
' ============================================================================
package "Tools Layer" as tools_layer {

    package "Base Tools" as base_tools {
        component "Image Viewer" as img_viewer <<Base Tool>>
        component "File Explorer" as file_explorer <<Base Tool>>
        component "Log Viewer" as log_viewer <<Base Tool>>
    }

    package "Extension Tools" as ext_tools {
        component "Identification Tool" as id_tool <<Tool>>
        component "Future Tool N" as future_tool <<Tool>> #LightGray
    }
}

' ============================================================================
' LAYER 2 – Tool Interface (middle)
' ============================================================================
package "Tool Interface Layer" as iface_layer {
    interface "IToolPlugin" as itool
    interface "IBaseToolPlugin" as ibase
    component "Tool Registry\n(static registration)" as tool_registry
}

' ============================================================================
' LAYER 3 – Shell / UI (middle-lower)
' ============================================================================
package "Shell / UI Layer" as shell_layer {
    component "Main Window" as main_window
    component "Docking Manager\n(Qt Advanced Docking)" as docking_mgr
    component "Navigation Bar" as nav_bar
    component "Layout Persistence" as layout_persist
}

' ============================================================================
' LAYER 4 – Application Core (bottom)
' ============================================================================
package "Application Core Layer" as core_layer {
    component "Application Lifecycle" as app_lifecycle
    component "Logging System" as logging
    component "Role Manager\n(Windows Accounts)" as role_mgr
    component "Configuration Manager\n(per-tool)" as config_mgr
}

' ============================================================================
' External
' ============================================================================
database "Layout State\n(File)" as layout_file
database "Tool Configs\n(Files)" as config_files
node "Windows OS\nUser Accounts" as win_os

' ============================================================================
' Relationships – Inheritance hierarchy
' ============================================================================
ibase -up-|> itool : extends

img_viewer .down.|> ibase
file_explorer .down.|> ibase
log_viewer .down.|> ibase

id_tool .down.|> itool
future_tool .down.|> itool

' ============================================================================
' Relationships – Static registration
' ============================================================================
tool_registry .up.> itool : holds references to\nall registered tools

' ============================================================================
' Relationships – Tool Interface to Shell
' ============================================================================
tool_registry .down.> main_window : provides tools
nav_bar .up.> tool_registry : reads categories
docking_mgr .up.> itool : embeds\nQWidget

' ============================================================================
' Relationships – Shell internal
' ============================================================================
main_window *-down- docking_mgr
main_window *-down- nav_bar
main_window .down.> layout_persist : save / restore

' ============================================================================
' Relationships – Shell to Core
' ============================================================================
layout_persist .down.> layout_file : persists
app_lifecycle .up.> main_window : creates &\nmanages
docking_mgr .down.> logging : logs events

' ============================================================================
' Relationships – Core internal & external
' ============================================================================
role_mgr .down.> win_os : queries
config_mgr .down.> config_files : reads / writes
app_lifecycle .right.> logging : initializes
app_lifecycle .right.> role_mgr : initializes
app_lifecycle .right.> config_mgr : initializes

' ============================================================================
' Notes
' ============================================================================
note right of itool
  Abstract interface every tool must implement.
  Provides: name, category, icon, metadata,
  create_widget() -> QWidget,
  on_activate(), on_deactivate(), on_close()
end note

note right of ibase
  Extends IToolPlugin with base-tool
  behaviour: auto-open on startup,
  multiple instances allowed,
  non-closable by default.
end note

note bottom of tool_registry
  All tools are statically imported
  and registered at build time.
  No runtime discovery.
  New tools: implement IToolPlugin,
  add import to registry module.
end note

@enduml
