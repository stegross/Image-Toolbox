@startuml host_shell_shutdown_activity
!theme plain
title Host Shell – Shutdown Activity

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam activityShape roundedBox

start

:User triggers close\n(window close / menu exit);

:MainWindow.closeEvent() triggered;

:Notify all active tools\nvia on_deactivate();

:Notify all active tools\nvia on_close();

:Save tool configurations\nvia ConfigManager;

:Serialize dock layout state\nvia DockingManager.save_state();

:Persist layout to file\nvia LayoutPersistence.save();

note right
  REQ-HS-007:
  Layout persisted
  between sessions.
end note

:Flush logging buffers;

:Release all resources;

:Application.quit();

stop

@enduml
