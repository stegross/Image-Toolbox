@startuml SCIBIT System Diagram
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Segoe UI
skinparam ArrowColor #444444
skinparam defaultFontSize 12

actor User

rectangle "SciBitTool\n(tool.py)" as Tool {
    component "Folder Selection\n& Config" as FolderSel
    component "Start / Stop" as StartStop
}

rectangle "Calibration Phase" as CalibPhase {
    component "CalibrationWidget\n(dumb surface)" as CW
    component "Pipeline.CalibrationController\n(state machine)" as CC
}

rectangle "Batch Phase" as BatchPhase {
    component "ResultsWidget\n(result list + review)" as RW
    component "SequentialBatchWorker\n(single thread)" as BW
}

rectangle "Pipeline Layer" as PipelineLayer {
    component "AbstractPipeline\n(Pipeline1 / Pipeline2)" as PL
    component "QRunnable workers\n(QThreadPool)" as Workers
}

rectangle "OCR Layer" as OcrLayer {
    component "AbstractOcrEngine" as Eng
    component "Tesseract" as T
    component "PaddleOCR" as P
    component "EasyOCR" as E
    T -u-|> Eng
    P -u-|> Eng
    E -u-|> Eng
}

User --> Tool : selects folder\npresses Start

Tool --> CalibPhase : creates pipeline\nshows CalibrationWidget
CC --> CW : drives\n(set_step, set_buttons,\nshow_rect_overlay…)
CW --> CC : signals\n(roi_drawn, ocr_confirmed)
CC --> PL : start_calibration()\nconfirm_chip() etc.
PL --> CC : chip_detected\nocr_result_ready\ncalibration_complete

PL --> CalibPhase : calibration_complete\n(CalibrationData)
Tool --> BatchPhase : start_batch(images, calib)\nshows ResultsWidget
BW --> RW : image_processed\nprogress_updated\nbatch_complete

PL --> Workers : spawns
Workers --> Eng : detect_text_regions()\nrecognize_text()
BW --> Eng : detect_text_regions()\nrecognize_text()

User --> RW : manual review\nrename / skip

@enduml
