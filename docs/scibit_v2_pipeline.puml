@startuml scibit_v2_pipeline
title SCIBIT v2 — Pipeline, Task & Configuration Structure

' ---------------------------------------------------------------------------
' Task definition — declared statically by each pipeline
' ---------------------------------------------------------------------------

package "pipeline.task" {

    class PreprocessingStep {
        ' A preprocessing operation that runs before the task's main framework call.
        ' Has its own config options shown in the UI.
        + name : str
        + display_name : str
        + default_config : dict
    }

    class TaskDefinition {
        ' Declared once per pipeline — shared by calibration and batch phases.
        ' The UI derives its per-task framework/model dropdowns from this.
        + index : int
        + display_name : str
        + required_capability : Capability
        + preprocessing_steps : list[PreprocessingStep]
    }

    TaskDefinition "1" *-- "0..*" PreprocessingStep

}

' ---------------------------------------------------------------------------
' Engine set — resolved at start time from config, shared where possible
' ---------------------------------------------------------------------------

package "pipeline.engine" {

    class EngineSet {
        ' Holds one loaded framework instance per unique (framework, model) pair.
        ' If two tasks share the same framework + model, they share one instance.
        + engine_for_task(task_index : int) : AbstractFramework
    }

    note right of EngineSet
      Created by AbstractPipeline.build_engine_set(config).
      Passed to both the CalibrationController and
      the SequentialBatchWorker.
    end note
}

' ---------------------------------------------------------------------------
' Abstract pipeline
' ---------------------------------------------------------------------------

package "pipeline" {

    abstract class AbstractPipeline {
        ' Defines the task sequence and wires calibration + batch.
        + {abstract} task_definitions() : list[TaskDefinition]
        + {abstract} create_calibration_controller() : AbstractCalibrationController
        + {abstract} start_batch(images, calib_data, engine_set, config, ...)
        + build_engine_set(config : PipelineConfig) : EngineSet
        ---
        ' Signals (same as v1)
        + image_processed : Signal
        + progress_updated : Signal
        + batch_complete : Signal
        + batch_error : Signal
    }

    class Pipeline1 {
        ' Task 0 — Shape detection      (SHAPE_DETECTION)
        '   preprocessing: grayscale, thresholding params
        ' Task 1 — Text region detection (TEXT_REGION_DETECTION)
        '   preprocessing: crop to chip region
        ' Task 2 — Text recognition      (TEXT_RECOGNITION)
        '   preprocessing: crop to identifier region
    }

    class Pipeline2 {
        ' Task 0 — Text recognition  (TEXT_RECOGNITION)
        '   preprocessing: scale ROI to image resolution,
        '                  expand by tolerance, text-snap
    }

    class PipelineX {
        ' Scaffold for future pipelines.
        ' Define task_definitions() and wire controllers/workers.
    }

    AbstractPipeline <|-- Pipeline1
    AbstractPipeline <|-- Pipeline2
    AbstractPipeline <|-- PipelineX

    AbstractPipeline --> TaskDefinition : "declares"
    AbstractPipeline --> EngineSet      : "builds"
}

' ---------------------------------------------------------------------------
' Calibration
' ---------------------------------------------------------------------------

package "calibration" {

    abstract class AbstractCalibrationController {
        ' Drives the CalibrationWidget through the task sequence.
        ' Inserts UI interactions between tasks.
        ' Receives EngineSet — calls engine_for_task(i) per step.
        + {abstract} start(widget, image_paths, engine_set) : None
        ---
        + calibration_complete : Signal[CalibrationData]
        + calibration_cancelled : Signal
    }

    abstract class CalibrationData {
        + reference_identifier : str
    }

    class Pipeline1CalibrationData {
        + chip_bbox : BoundingBox
        + identifier_bbox_norm : BoundingBox
        + chip_aspect_ratio : float
    }

    class Pipeline2CalibrationData {
        + roi_bbox : BoundingBox
        + reference_resolution : tuple[int, int]
    }

    CalibrationData <|-- Pipeline1CalibrationData
    CalibrationData <|-- Pipeline2CalibrationData
    AbstractCalibrationController --> CalibrationData : "produces"
}

' ---------------------------------------------------------------------------
' Batch
' ---------------------------------------------------------------------------

package "batch" {

    class SequentialBatchWorker {
        ' Runs the pipeline's task sequence on every image
        ' sequentially on one background thread.
        ' Uses EngineSet for all framework calls.
        + run() : None
        ---
        + signals : WorkerSignals
    }
}

' ---------------------------------------------------------------------------
' Configuration
' ---------------------------------------------------------------------------

package "config" {

    class FrameworkModelRef {
        ' Lightweight reference stored in config files.
        ' Resolved to a real FrameworkModel + instance at start time.
        + framework_name : str
        + model_id : str
    }

    class TaskConfig {
        + task_index : int
        + framework_ref : FrameworkModelRef
        + preprocessing_config : dict
    }

    class PipelineConfig {
        ' One named configuration file on disk.
        + pipeline_type : str
        + task_configs : list[TaskConfig]
        + min_confidence : float
        + rename_preview : bool
    }

    class ConfigRegistry {
        ' Scans the SCIBIT config folder.
        + default_config() : PipelineConfig    <<hard-coded>>
        + list_available() : list[Path]
        + load(path : Path) : PipelineConfig
        + save(config : PipelineConfig, path : Path) : None
    }

    PipelineConfig  "1" *-- "N" TaskConfig
    TaskConfig       -->        FrameworkModelRef
    ConfigRegistry   -->        PipelineConfig : "creates / loads"
}

' ---------------------------------------------------------------------------
' UI
' ---------------------------------------------------------------------------

package "ui.config" {

    class ConfigPanel {
        ' Reads task_definitions() from the selected pipeline to
        ' build per-task framework + model dropdowns dynamically.
        ' Reads/writes PipelineConfig.
        + selected_config : PipelineConfig
        + pipeline_changed : Signal
    }

    note right of ConfigPanel
      Framework dropdowns are filtered:
      only frameworks whose provided_capabilities()
      include the task's required_capability are shown.
      Model dropdown is populated from
      framework.available_models().
    end note
}

package "ui.calibration" {

    class CalibrationWidget {
        ' Dumb surface — unchanged from v1.
        ' [KEEP]
    }
}

' ---------------------------------------------------------------------------
' Cross-package wiring
' ---------------------------------------------------------------------------

AbstractPipeline          --> AbstractCalibrationController : "creates"
AbstractPipeline          --> SequentialBatchWorker         : "creates"
ConfigPanel               --> PipelineConfig                : "reads / writes"
ConfigPanel               --> AbstractPipeline              : "queries task_definitions()"
AbstractCalibrationController --> EngineSet                 : "uses"
SequentialBatchWorker         --> EngineSet                 : "uses"

@enduml
