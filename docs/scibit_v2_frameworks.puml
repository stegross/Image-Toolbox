@startuml scibit_v2_frameworks
title SCIBIT v2 — Framework & Capability Abstraction

package "frameworks" {

    enum Capability {
        SHAPE_DETECTION
        TEXT_REGION_DETECTION
        TEXT_RECOGNITION
    }

    class OcrResult {
        + text : str
        + confidence : float
    }

    class BoundingBox {
        + x : float
        + y : float
        + width : float
        + height : float
    }

    class FrameworkModel {
        + id : str
        + display_name : str
        + description : str
    }

    ' ---------------------------------------------------------------------------
    ' Abstract framework roles
    ' ---------------------------------------------------------------------------

    abstract class AbstractFramework {
        + {abstract} name() : str
        + {abstract} provided_capabilities() : set[Capability]
        + {abstract} available_models() : list[FrameworkModel]
        + {abstract} load_model(model: FrameworkModel) : None
    }

    abstract class AbstractShapeDetector {
        ' Finds non-text objects by outline / contour.
        ' Example: chip boundary via thresholding.
        + {abstract} detect_shapes(image : QImage) : list[BoundingBox]
    }

    abstract class AbstractTextDetector {
        ' Finds where text is — returns bounding boxes, does NOT read.
        + {abstract} detect_text_regions(image : QImage) : list[BoundingBox]
    }

    abstract class AbstractTextRecognizer {
        ' Reads text from a pre-cropped region.
        + {abstract} recognize_text(image : QImage) : OcrResult
    }

    AbstractFramework <|-- AbstractShapeDetector
    AbstractFramework <|-- AbstractTextDetector
    AbstractFramework <|-- AbstractTextRecognizer

    ' ---------------------------------------------------------------------------
    ' Concrete implementations
    ' A framework may implement one or more roles.
    ' ---------------------------------------------------------------------------

    class OpenCvFramework {
        ' Provides: SHAPE_DETECTION only.
        ' Models: thresholding algorithm variants
        ' (e.g. Otsu, Adaptive, EAST, CRAFT).
        + MODELS : list[FrameworkModel]  <<class attribute>>
        + detect_shapes(image) : list[BoundingBox]
    }

    class TesseractFramework {
        ' Provides: TEXT_REGION_DETECTION, TEXT_RECOGNITION.
        ' Models: installed tessdata language files
        ' (e.g. eng, deu, fra).
        + MODELS : list[FrameworkModel]  <<class attribute>>
        + detect_text_regions(image) : list[BoundingBox]
        + recognize_text(image) : OcrResult
    }

    class EasyOcrFramework {
        ' Provides: TEXT_REGION_DETECTION, TEXT_RECOGNITION.
        ' Models: language combinations
        ' (e.g. ["en"], ["en", "de"]).
        + MODELS : list[FrameworkModel]  <<class attribute>>
        + detect_text_regions(image) : list[BoundingBox]
        + recognize_text(image) : OcrResult
    }

    class PaddleOcrFramework {
        ' Provides: TEXT_REGION_DETECTION, TEXT_RECOGNITION.
        ' Models: size × language
        ' (e.g. mobile_en, server_en, mobile_de).
        + MODELS : list[FrameworkModel]  <<class attribute>>
        + detect_text_regions(image) : list[BoundingBox]
        + recognize_text(image) : OcrResult
    }

    AbstractShapeDetector  <|-- OpenCvFramework

    AbstractTextDetector   <|-- TesseractFramework
    AbstractTextRecognizer <|-- TesseractFramework

    AbstractTextDetector   <|-- EasyOcrFramework
    AbstractTextRecognizer <|-- EasyOcrFramework

    AbstractTextDetector   <|-- PaddleOcrFramework
    AbstractTextRecognizer <|-- PaddleOcrFramework
}

note bottom of OpenCvFramework
  Only concrete framework that does NOT
  perform any OCR. Pure CV / geometry.
end note

note right of AbstractFramework
  available_models() returns the statically
  coded list — no runtime discovery.
  load_model() initialises the underlying
  library with the chosen model.
end note

@enduml
