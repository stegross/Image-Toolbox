{
  "pipeline": "feature_based_alignment",
  "pipeline_options": {
    "identifier_pattern_preset": "One uppercase letter + 2 digits + hyphen + 2 digits (e.g. A11-11, F09-07, X99-99)",
    "manual_confirmation_required": true,
    "confidence_threshold_percent": 98.0,
    "debug_export_mode": "all"
  },
  "stages": {
    "calibration_setup": {
      "operator": "",
      "parameters": {
        "rotation_degrees": -91.0,
        "invert_colors": true,
        "downscale_factor": 30
      }
    },
    "identifier_region_selection": {
      "operator": "",
      "parameters": {
        "roi_tolerance_margin": 10
      }
    },
    "roi_preprocess": {
      "operator": "OpenCVOperator",
      "parameters": {
        "clahe_enabled": true,
        "clahe_clip_limit": 6.0,
        "clahe_tile_grid_size": 6,
        "adaptive_threshold_enabled": false,
        "adaptive_threshold_method": "GAUSSIAN",
        "adaptive_threshold_block_size": 11,
        "adaptive_threshold_c": 2,
        "adaptive_threshold_invert": false
      }
    },
    "text_recognition": {
      "operator": "PaddleOCROperator",
      "parameters": {
        "decoder": "greedy",
        "rec_model": "server"
      }
    },
    "validation": {
      "operator": "",
      "parameters": {}
    }
  }
}